{
  "id": "socialstudio0002",
  "name": "Social Studio 02 - AI Content Preparation",
  "active": false,
  "nodes": [
    {
      "id": "85a93704a46e4e330262cfc18e66fdf0",
      "name": "Subworkflow input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
