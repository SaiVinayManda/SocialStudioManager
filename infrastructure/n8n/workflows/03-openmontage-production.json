          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "socialstudioauth",
          "name": "Social Studio internal API"
        }
      }
    },
    {
      "id": "93e6dd8fd987bf2b5d25331ad439d691",
