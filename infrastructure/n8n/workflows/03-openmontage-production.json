    },
    {
      "id": "b8d2a34f17570370cebd908c2e93476a",
      "name": "Notification production-failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "job_id",
              "value": "={{ $json.job_id || $json.content_job_id }}"
            },
            {
              "name": "event_type",
              "value": "production.failed"
            },
            {
              "name": "idempotency_key",
              "value": "={{ 'production.failed:' + ($json.job_id || $json.content_job_id) + ':' + ($json.id || $json.content_version || '1') }}"
            }
          ]
        }
      }
    },
    {
      "id": "d7786742cd6070eded4659b18d9f3080",
      "name": "Deliver production-failure",
