        }
      }
    },
    {
      "id": "ec565871268c2f3a4140c7bfae102810",
      "name": "Validate output",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "socialstudio0004",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    },
    {
      "id": "dc12accae1aba642cf855d4d60b60da8",
      "name": "Production failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
