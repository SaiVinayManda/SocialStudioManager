{
  "id": "socialstudio0007",
  "name": "Social Studio 07 - Youtube Mock Publishing",
  "active": false,
  "nodes": [
    {
      "id": "a669fecedb550a18b346e1a99fc03995",
      "name": "Subworkflow input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "fecc5883eea41c61f719d553a694b2a3",
      "name": "Publish mock youtube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://studio-api:8780/publishing/' + $json.id + '/publish/youtube' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "socialstudioauth",
          "name": "Social Studio internal API"
        }
      }
    },
    {
      "id": "d2aa491cb9170d5d75add03a6300a027",
      "name": "Notification youtube",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "job_id",
              "value": "={{ $json.job_id || $json.content_job_id }}"
            },
            {
              "name": "event_type",
              "value": "publishing.succeeded"
            },
            {
              "name": "idempotency_key",
              "value": "={{ 'publishing.succeeded:' + ($json.job_id || $json.content_job_id) + ':' + ($json.id || $json.content_version || '1') }}"
            }
          ]
        }
      }
    },
    {
      "id": "277f5269a020984768d1a9ecb88630e1",
      "name": "Deliver youtube",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "socialstudio0010",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Subworkflow input": {
      "main": [
        [
          {
            "node": "Publish mock youtube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish mock youtube": {
      "main": [
        [
          {
            "node": "Notification youtube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notification youtube": {
      "main": [
        [
          {
            "node": "Deliver youtube",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": false,
    "errorWorkflow": "socialstudio0011"
  },
  "tags": [],
  "pinData": {}
}
